<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>MaximeLB.OfficeEditor.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>MaximeLB</Authors>
    <Description>Multi-format Office document CLI tool (DOCX, PPTX, XLSX)</Description>
    <RepositoryUrl>https://github.com/MaximeLeBesnerais/OfficeEditor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>officeeditor</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeEditor.Core\OfficeEditor.Core.csproj" />
    <ProjectReference Include="..\DocxEditor.Core\DocxEditor.Core.csproj" />
    <ProjectReference Include="..\PptxEditor.Core\PptxEditor.Core.csproj" />
    <ProjectReference Include="..\XlsxEditor.Core\XlsxEditor.Core.csproj" />
  </ItemGroup>

</Project>
