{
  "version": "1.0",
  "description": "Sample instruction set demonstrating DOCX manipulation via JSON.",
  "operations": [
    {
      "type": "create"
    },
    {
      "type": "addParagraph",
      "text": "This paragraph was added via JSON instructions.",
      "style": "Normal"
    },
    {
      "type": "addParagraph",
      "text": "Section Added by Instructions",
      "style": "Heading2"
    },
    {
      "type": "addParagraph",
      "text": "\u2022 First bullet point"
    },
    {
      "type": "addParagraph",
      "text": "\u2022 Second bullet point"
    },
    {
      "type": "addParagraph",
      "text": "\u2022 Third bullet point"
    },
    {
      "type": "replaceText",
      "find": "{{companyName}}",
      "replace": "Acme Corporation"
    },
    {
      "type": "replaceText",
      "find": "{{date}}",
      "replace": "2024-01-15"
    },
    {
      "type": "insertAfter",
      "target": "added via JSON",
      "content": {
        "text": "This line was inserted after the first paragraph.",
        "style": "Normal"
      }
    }
  ]
}
