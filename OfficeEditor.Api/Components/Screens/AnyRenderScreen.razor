@* AnyRenderScreen.razor — Upload any .pptx for render (matches React AnyRenderScreen.tsx) *@

@inject IDemoDeckService DemoDeckService

<div class="space-y-8">
    <section class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-50">
            Render any deck
        </h1>
        <p class="text-slate-400">
            Drop in your own .pptx — the OfficeEditor Engine compiles every slide to a preview.
        </p>
    </section>

    <div class="space-y-4">
        <label class="@UploadClasses()">
            <InputFile accept=".pptx" disabled="@_rendering"
                       OnChange="HandleFilePicked"
                       class="sr-only" />
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                 class="h-10 w-10 text-slate-500" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
            </svg>
            @if (_fileName is not null)
            {
                <div class="space-y-1">
                    <p class="truncate text-lg font-bold text-slate-100">@_fileName</p>
                    <p class="font-mono text-xs text-slate-500">@FormatBytes(_fileSize)</p>
                </div>
            }
            else
            {
                <div class="space-y-1">
                    <p class="text-lg font-bold text-slate-200">Choose a .pptx file</p>
                    <p class="text-sm text-slate-500">Click to browse your files</p>
                </div>
            }
        </label>

        @if (_pickError is not null)
        {
            <StatusMessage Type="error" Title="Invalid file" Message="_pickError" />
        }

        <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm font-semibold text-slate-300">Preview format</span>
            <FormatToggle Value="@_format" ValueChanged="OnFormatChanged" Disabled="@_rendering" />
        </div>

        <div class="flex flex-wrap items-center gap-4">
            <button type="button"
                    @onclick="HandleRender"
                    disabled="@(_fileBytes is null || _rendering)"
                    class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 bg-gradient-to-r from-indigo-500 to-violet-600 font-bold text-white shadow-lg shadow-indigo-500/25 hover:from-indigo-400 hover:to-violet-500 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 focus:ring-offset-slate-950 disabled:cursor-not-allowed disabled:opacity-50 transition-all duration-200">
                Render deck
            </button>
            @if ((_result is not null || _renderError is not null) && !_rendering)
            {
                <button type="button"
                        @onclick="HandleReset"
                        class="text-sm font-semibold text-slate-400 transition-colors hover:text-slate-200">
                    Render another deck
                </button>
            }
        </div>
    </div>

    @if (_rendering && _fileName is not null)
    {
        <div class="fade-in-up flex items-center gap-4 rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <Spinner />
            <div>
                <p class="font-semibold text-slate-100">Rendering @_fileName…</p>
                <p class="text-sm text-slate-400">OfficeEditor Engine compiling slides</p>
            </div>
        </div>
    }

    @if (_renderError is not null)
    {
        <StatusMessage Type="error" Title="Render failed" Message="_renderError" />
    }

    @if (_result is not null)
    {
        <div class="fade-in-up space-y-5">
            <TimingReceipt Stats="_result.Stats" />
            <SlideGallery Slides="_result.Slides" Title="_result.FileName" />
        </div>
    }
</div>

@code {
    private string? _fileName;
    private long _fileSize;
    private byte[]? _fileBytes;
    private string? _pickError;
    private bool _rendering;
    private RenderResult? _result;
    private string? _renderError;
    private string _format = "png";
    private int _inputKey;

    private sealed class RenderResult
    {
        public required string FileName { get; init; }
        public required IReadOnlyList<GallerySlide> Slides { get; init; }
        public required TimingStats Stats { get; init; }
    }

    private string UploadClasses() =>
        "flex cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed p-10 text-center transition-all duration-200 "
        + "border-slate-700 bg-slate-900/60 hover:border-indigo-500/60 hover:bg-slate-900 "
        + (_rendering ? "pointer-events-none opacity-60" : "");

    private async Task HandleFilePicked(InputFileChangeEventArgs e)
    {
        _result = null;
        _renderError = null;
        var file = e.File;
        if (file is null)
        {
            _fileName = null;
            _fileBytes = null;
            _pickError = null;
            return;
        }
        if (!file.Name.EndsWith(".pptx", StringComparison.OrdinalIgnoreCase))
        {
            _fileName = null;
            _fileBytes = null;
            _pickError = $"\"{file.Name}\" is not a .pptx file. Pick a PowerPoint deck.";
            return;
        }
        _pickError = null;
        _fileName = file.Name;
        _fileSize = file.Size;
        await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _fileBytes = ms.ToArray();
    }

    private async Task HandleRender()
    {
        if (_fileBytes is null || _fileName is null) return;
        _rendering = true;
        _renderError = null;
        _result = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var format = _format;
            var response = await Task.Run(() =>
                DemoDeckService.RenderUploadedDeck(_fileBytes, _fileName, format, DeckPreviewValidators.DefaultPpi));

            _result = new RenderResult
            {
                FileName = _fileName,
                Slides = response.Pages.Select((b, i) => new GallerySlide(i + 1, $"data:{DeckPreviewValidators.ContentTypeForFormat(response.Format)};base64,{Convert.ToBase64String(b)}")).ToList(),
                Stats = new TimingStats
                {
                    Slides = response.SlideCount,
                    TotalMs = response.TotalMilliseconds,
                    PerSlideMs = response.SlideCount > 0 ? response.TotalMilliseconds / response.SlideCount : 0,
                    Label = "rendered",
                },
            };
        }
        catch (Exception ex)
        {
            _renderError = ex.Message;
        }
        finally
        {
            _rendering = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleReset()
    {
        _fileName = null;
        _fileBytes = null;
        _pickError = null;
        _result = null;
        _renderError = null;
        _inputKey++;
    }

    private async Task OnFormatChanged(string fmt) => _format = fmt;

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024.0):F1} MB",
    };
}
