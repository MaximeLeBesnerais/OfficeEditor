@* StatsStrip.razor — Stats strip: total wall time + per-stage breakdown + slides + slides/sec *@

<div class="flex flex-wrap items-center gap-2">
    <span class="inline-flex items-baseline gap-1.5 rounded-full border border-emerald-500/50 bg-emerald-500/10 px-4 py-1.5 font-mono text-sm text-emerald-200 shadow-lg shadow-emerald-500/10">
        <span class="font-semibold">@FormatDuration(TotalMs)</span>
        <span class="text-emerald-400/70">total</span>
    </span>
    @foreach (var stage in Stages)
    {
        <span class="inline-flex items-baseline gap-1.5 rounded-full border border-slate-700/80 bg-slate-900/80 px-4 py-1.5 font-mono text-sm text-slate-300">
            <span class="text-slate-500">@stage.Label</span>
            <span class="text-slate-100">@FormatDuration(stage.Milliseconds)</span>
        </span>
    }
    <span class="inline-flex items-baseline gap-1.5 rounded-full border border-slate-700/80 bg-slate-900/80 px-4 py-1.5 font-mono text-sm text-slate-300">
        <span class="font-semibold text-slate-100">@Slides</span>
        <span class="text-slate-500">slides</span>
    </span>
    <span class="inline-flex items-baseline gap-1.5 rounded-full border border-slate-700/80 bg-slate-900/80 px-4 py-1.5 font-mono text-sm text-slate-300">
        <span class="font-semibold text-slate-100">@SlidesPerSecond.ToString("F1")</span>
        <span class="text-slate-500">slides/s</span>
    </span>
</div>

@code {
    [Parameter] public int Slides { get; set; }
    [Parameter] public double TotalMs { get; set; }
    [Parameter] public IReadOnlyList<StageTiming> Stages { get; set; } = [];

    private double SlidesPerSecond => Slides > 0 && TotalMs > 0 ? Slides / (TotalMs / 1000.0) : 0;

    private static string FormatDuration(double ms) =>
        ms >= 4000 ? $"{ms / 1000:F1} s" : ms >= 100 ? $"{ms:F0} ms" : $"{ms:F1} ms";
}
