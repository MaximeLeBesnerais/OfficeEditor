<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>MCP stdio host exposing PPTX deck anatomy, editing, and slide rendering tools</Description>
  </PropertyGroup>

  <!-- Zero third-party dependencies: the JSON-RPC 2.0 / MCP protocol layer is
       hand-rolled over System.Text.Json (in-box). Only Core project references. -->
  <ItemGroup>
    <ProjectReference Include="..\OfficeEditor.Core\OfficeEditor.Core.csproj" />
    <ProjectReference Include="..\PptxEditor.Core\PptxEditor.Core.csproj" />
  </ItemGroup>

</Project>
