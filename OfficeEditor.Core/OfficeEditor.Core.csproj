<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>MaximeLB.OfficeEditor.Core</PackageId>
    <Version>0.7.0</Version>
    <Authors>MaximeLB</Authors>
    <Description>Shared services and models for OfficeEditor document manipulation</Description>
    <RepositoryUrl>https://github.com/MaximeLeBesnerais/OfficeEditor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Link="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TypstBridge\managed\TypstBridge.Managed.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Format cores implement the shared facade's internal IFormatRenderer. -->
    <InternalsVisibleTo Include="PptxEditor.Core" />
    <InternalsVisibleTo Include="DocxEditor.Core" />
    <InternalsVisibleTo Include="XlsxEditor.Core" />
  </ItemGroup>

</Project>
